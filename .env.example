# Copy to .env and fill in from your Supabase project:
#   Project Settings -> Data API  -> Project URL
#   Project Settings -> API Keys  -> anon / public, or the publishable key
#
# Both values are public by design and safe to ship in the page; row level
# security is what protects the data.
# NEVER put the service_role or sb_secret_ key here - those bypass RLS.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY
