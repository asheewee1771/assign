# Copy to .env and fill in from your Supabase project:
#   Project Settings -> Data API -> Project URL
#   Project Settings -> API Keys  -> anon / public
#
# Both values are safe to expose publicly; writes are protected by row level
# security. NEVER put the service_role key here.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY
